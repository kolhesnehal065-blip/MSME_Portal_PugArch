generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                    @id @default(autoincrement())
  name                    String
  email                   String                 @unique
  userId                  String?                @unique
  password                String
  role                    Role
  registrationStatus      RegistrationStatus     @default(incomplete)
  onboardingStatus        OnboardingStatus       @default(pending)
  sectionStatus           Json?
  sectionRejectionReasons Json?
  registrationDetails     Json?
  adminFeedback           String?                @default("")
  mobile                  String?
  dob                     DateTime?
  isDualRole              Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  Approval                Approval[]
  AuditLog                AuditLog[]
  bids                    Bid[]
  buyerProfile            BuyerProfile?
  sentRequests            QuoteRequest[]         @relation("BuyerRequests")
  receivedRequests        QuoteRequest[]         @relation("SellerRequests")
  sellerProfile           SellerProfile?
  tenders                 Tender[]
  productCatalogueItems   ProductCatalogueItem[] @relation("SellerProducts")
  serviceCatalogueItems   ServiceCatalogueItem[] @relation("SellerServices")
  purchaseRequests        PurchaseRequest[]      @relation("BuyerPurchaseRequests")
  buyerPurchaseOrders     PurchaseOrder[]        @relation("BuyerPurchaseOrders")
  sellerPurchaseOrders    PurchaseOrder[]        @relation("SellerPurchaseOrders")
  buyerContracts          Contract[]             @relation("BuyerContracts")
  sellerContracts         Contract[]             @relation("SellerContracts")
  buyerInvoices           Invoice[]              @relation("BuyerInvoices")
  sellerInvoices          Invoice[]              @relation("SellerInvoices")
  technicalEvaluations    TechnicalEvaluation[]
  financialEvaluations    FinancialEvaluation[]
  reverseAuctionBids      ReverseAuctionBid[]

  rbacRoleId Int?
  rbacRole   RbacRole? @relation(fields: [rbacRoleId], references: [id])
}

model RbacRole {
  id          Int     @id @default(autoincrement())
  name        String  @unique // e.g. "Administrator", "Seller Level 1"
  description String?

  // Hierarchy mapping
  parentRoleId Int?
  parentRole   RbacRole?  @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   RbacRole[] @relation("RoleHierarchy")

  users       User[]
  permissions RbacRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RbacPermission {
  id          Int     @id @default(autoincrement())
  code        String  @unique // e.g. "tender:create"
  name        String
  description String?
  group       String? // Category like "Procurement", "Inventory"

  roles RbacRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RbacRolePermission {
  roleId       Int
  permissionId Int

  role       RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model BuyerProfile {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  organizationName      String
  businessType          String
  industry              String?
  cin                   String?
  pan                   String?
  gst                   String?
  website               String?
  state                 String?
  district              String?
  officeZoneName        String?
  representativeName    String?
  designation           String?
  department            String?
  email                 String?
  mobile                String
  alternateMobile       String?
  aadhaarNumber         String?
  aadhaarVerified       Boolean  @default(false)
  country               String   @default("India")
  city                  String?
  pincode               String?
  registeredAddress     String?
  corporateAddress      String?
  procurementCategories String[]
  otherCategoryDetails  String?
  annualBudget          String?
  preferredMethods      String[]
  otherMethodDetails    String?
  declarationAccepted   Boolean  @default(false)
  termsAccepted         Boolean  @default(false)
  documents             Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id                           Int                 @id @default(autoincrement())
  userId                       Int                 @unique
  organizationType             String?
  pan                          String              @unique
  nameAsInPan                  String?
  dateAsInPan                  DateTime?
  panVerified                  Boolean             @default(false)
  businessName                 String?
  dateOfIncorporation          DateTime?
  detailsUpdated               Boolean             @default(false)
  isStartup                    Boolean             @default(false)
  isUdyamCertified             Boolean             @default(false)
  participateInBid             Boolean             @default(false)
  optForSahay                  Boolean             @default(false)
  turnoverMax3Yrs              String?
  eInvoicingExcluded           Boolean             @default(false)
  ownershipDeclarationAccepted Boolean             @default(false)
  ownershipVerified            Boolean             @default(false)
  mobile                       String?
  dob                          DateTime?
  roleInOrg                    String?
  msmeCategory                 String?
  productCategories            String[]
  otherCategoryDetails         String?
  productList                  String?
  detailedProductName          String?
  hsnCode                      String?
  brand                        String?
  specifications               String?
  documents                    Json?
  aadhaarNumber                String?
  aadhaarVerified              Boolean             @default(false)
  termsAccepted                Boolean             @default(false)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  catalogType                  String?
  bankAccounts                 SellerBankAccount[]
  offices                      SellerOffice[]
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerOffice {
  id              Int           @id @default(autoincrement())
  sellerProfileId Int
  name            String
  type            String
  gstRegistered   Boolean       @default(false)
  gstNumber       String?
  declaringAs     String?
  pincode         String
  state           String
  city            String
  address         String
  contactNumber   String?
  isMandatory     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
}

model SellerBankAccount {
  id              Int           @id @default(autoincrement())
  sellerProfileId Int
  ifsc            String
  bankName        String
  bankAddress     String
  holderName      String
  accountNumber   String
  isPrimary       Boolean       @default(false)
  isVerified      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
}

model Tender {
  id                    Int                    @id @default(autoincrement())
  buyerId               Int
  tenderId              String                 @unique
  title                 String
  category              String
  budget                Float
  description           String
  documentUrl           String?
  status                TenderStatus           @default(draft)
  bidsCount             Int                    @default(0)
  closesAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  Auction               Auction?
  bids                  Bid[]
  buyer                 User                   @relation(fields: [buyerId], references: [id])
  purchaseRequests      PurchaseRequest[]
  evaluationCriteria    EvaluationCriteria[]
  technicalEvaluations  TechnicalEvaluation[]
  financialEvaluations  FinancialEvaluation[]
  comparativeStatements ComparativeStatement[]
  contracts             Contract[]
}

model Bid {
  id       Int    @id @default(autoincrement())
  tenderId Int
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  sellerId Int
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  unitPrice    Float
  quantity     Int
  deliveryDays Int
  warranty     String?
  validTill    DateTime?
  note         String?
  status       String    @default("pending") // pending, accepted, rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenderId, sellerId], name: "bidCompoundId")
}

model Otp {
  id         Int      @id @default(autoincrement())
  email      String
  otp        String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model QuoteRequest {
  id          Int      @id @default(autoincrement())
  buyerId     Int
  sellerId    Int
  subject     String
  message     String
  documentUrl String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  buyer       User     @relation("BuyerRequests", fields: [buyerId], references: [id])
  seller      User     @relation("SellerRequests", fields: [sellerId], references: [id])
}

model Approval {
  id         Int      @id @default(autoincrement())
  userId     Int
  entityType String
  entityId   Int
  status     String   @default("approved")
  remarks    String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Auction {
  id         Int                 @id @default(autoincrement())
  tenderId   Int                 @unique
  startPrice Float
  currentBid Float?
  startTime  DateTime
  endTime    DateTime
  status     String              @default("active")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime
  Tender     Tender              @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  bids       ReverseAuctionBid[]
}

model ProcurementCategory {
  id               Int                    @id @default(autoincrement())
  parentId         Int?
  parent           ProcurementCategory?   @relation("CategoryTree", fields: [parentId], references: [id])
  children         ProcurementCategory[]  @relation("CategoryTree")
  name             String
  code             String                 @unique
  industry         String?
  hsnSac           String?
  description      String?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  products         ProductCatalogueItem[]
  services         ServiceCatalogueItem[]
  purchaseRequests PurchaseRequest[]
}

model ProductCatalogueItem {
  id               Int                  @id @default(autoincrement())
  sellerId         Int
  seller           User                 @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId       Int?
  category         ProcurementCategory? @relation(fields: [categoryId], references: [id])
  name             String
  sku              String?
  hsnCode          String?
  brand            String?
  description      String?
  technicalSpecs   Json?
  unitOfMeasure    String               @default("Unit")
  basePrice        Float?
  currency         String               @default("INR")
  certifications   Json?
  complianceDocs   Json?
  standardTemplate Json?
  status           String               @default("active")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model ServiceCatalogueItem {
  id              Int                  @id @default(autoincrement())
  sellerId        Int
  seller          User                 @relation("SellerServices", fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId      Int?
  category        ProcurementCategory? @relation(fields: [categoryId], references: [id])
  name            String
  sacCode         String?
  description     String?
  scopeDefinition Json?
  pricingModel    String               @default("fixed")
  basePrice       Float?
  currency        String               @default("INR")
  serviceLevel    String?
  complianceDocs  Json?
  status          String               @default("active")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model PurchaseRequest {
  id                Int                  @id @default(autoincrement())
  requestNo         String               @unique
  buyerId           Int
  buyer             User                 @relation("BuyerPurchaseRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  tenderId          Int?
  tender            Tender?              @relation(fields: [tenderId], references: [id])
  categoryId        Int?
  category          ProcurementCategory? @relation(fields: [categoryId], references: [id])
  title             String
  description       String?
  procurementMethod String               @default("tender")
  estimatedValue    Float?
  boqDocumentUrl    String?
  status            String               @default("draft")
  requiredBy        DateTime?
  department        String?
  deliveryLocation  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  boqItems          BOQItem[]
  purchaseOrders    PurchaseOrder[]
}

model BOQItem {
  id                Int             @id @default(autoincrement())
  purchaseRequestId Int
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  lineNo            Int
  itemName          String
  description       String?
  quantity          Float
  unit              String          @default("Unit")
  estimatedRate     Float?
  specifications    Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PurchaseOrder {
  id                Int                 @id @default(autoincrement())
  poNumber          String              @unique
  buyerId           Int
  buyer             User                @relation("BuyerPurchaseOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId          Int?
  seller            User?               @relation("SellerPurchaseOrders", fields: [sellerId], references: [id])
  purchaseRequestId Int?
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  contractId        Int?
  contract          Contract?           @relation(fields: [contractId], references: [id])
  title             String
  totalValue        Float
  currency          String              @default("INR")
  status            String              @default("draft")
  expectedDelivery  DateTime?
  deliveryAddress   String?
  amendmentHistory  Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  items             PurchaseOrderItem[]
  shipments         Shipment[]
  inspections       InspectionReport[]
  invoices          Invoice[]
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName        String
  description     String?
  quantity        Float
  unit            String        @default("Unit")
  unitPrice       Float
  taxRate         Float?
  totalPrice      Float
  technicalSpecs  Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Shipment {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  trackingNo       String        @unique
  carrier          String?
  status           String        @default("scheduled")
  scheduledDate    DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  currentLocation  String?
  deliveryProofUrl String?
  timeline         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model InspectionReport {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  reportNo        String        @unique
  inspectedBy     String?
  status          String        @default("pending")
  acceptedQty     Float?
  rejectedQty     Float?
  remarks         String?
  reportUrl       String?
  checklist       Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Invoice {
  id                Int            @id @default(autoincrement())
  invoiceNo         String         @unique
  purchaseOrderId   Int?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  buyerId           Int
  buyer             User           @relation("BuyerInvoices", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId          Int?
  seller            User?          @relation("SellerInvoices", fields: [sellerId], references: [id])
  amount            Float
  taxAmount         Float?
  totalAmount       Float
  status            String         @default("uploaded")
  invoiceUrl        String?
  verificationNotes String?
  dueDate           DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Contract {
  id             Int             @id @default(autoincrement())
  contractNo     String          @unique
  buyerId        Int
  buyer          User            @relation("BuyerContracts", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       Int?
  seller         User?           @relation("SellerContracts", fields: [sellerId], references: [id])
  tenderId       Int?
  tender         Tender?         @relation(fields: [tenderId], references: [id])
  title          String
  contractType   String          @default("standard")
  startDate      DateTime?
  endDate        DateTime?
  totalValue     Float?
  status         String          @default("draft")
  documentUrl    String?
  terms          Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          ContractItem[]
  purchaseOrders PurchaseOrder[]
}

model ContractItem {
  id          Int      @id @default(autoincrement())
  contractId  Int
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  itemName    String
  description String?
  rate        Float?
  unit        String   @default("Unit")
  ceilingQty  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReverseAuctionBid {
  id        Int      @id @default(autoincrement())
  auctionId Int
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  sellerId  Int
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  bidAmount Float
  rank      Int?
  createdAt DateTime @default(now())
}

model EvaluationCriteria {
  id          Int      @id @default(autoincrement())
  tenderId    Int
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  type        String
  name        String
  description String?
  maxScore    Float    @default(100)
  weight      Float    @default(1)
  isMandatory Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TechnicalEvaluation {
  id                Int      @id @default(autoincrement())
  tenderId          Int
  tender            Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  bidId             Int?
  evaluatorId       Int?
  evaluator         User?    @relation(fields: [evaluatorId], references: [id])
  score             Float    @default(0)
  status            String   @default("pending")
  remarks           String?
  documentsVerified Boolean  @default(false)
  criteriaScores    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FinancialEvaluation {
  id              Int      @id @default(autoincrement())
  tenderId        Int
  tender          Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  bidId           Int?
  evaluatorId     Int?
  evaluator       User?    @relation(fields: [evaluatorId], references: [id])
  quotedPrice     Float
  benchmarkPrice  Float?
  variancePercent Float?
  anomalyFlag     Boolean  @default(false)
  rank            Int?
  status          String   @default("pending")
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ComparativeStatement {
  id               Int      @id @default(autoincrement())
  tenderId         Int
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  statementNo      String   @unique
  summary          Json
  recommendedBidId Int?
  documentUrl      String?
  status           String   @default("generated")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String?
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GstCache {
  id                     Int       @id @default(autoincrement())
  gstNumber              String    @unique
  legalBusinessName      String
  tradeName              String?
  constitutionOfBusiness String?
  registrationDate       DateTime?
  taxpayerType           String?
  businessAddress        String?
  state                  String?
  pincode                String?
  lastVerified           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

enum Role {
  seller
  buyer
  admin
}

enum RegistrationStatus {
  incomplete
  completed
}

enum OnboardingStatus {
  pending
  pending_validation
  under_compliance_review
  resubmission_required
  approved_for_procurement
  rejected
}

enum TenderStatus {
  draft
  approved
  published
  bid_submission
  tech_bid_opening
  tech_evaluation
  financial_bid_opening
  financial_opening
  financial_evaluation
  awarded
  po_generated
  closed
}
